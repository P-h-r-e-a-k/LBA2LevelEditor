<Window x:Class="LBA2LevelEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LBA2LevelEditor"
        Title="LBA Level Workshop" Height="760" Width="1280" MinHeight="620" MinWidth="980"
        Background="#101418" Foreground="#E8E6DA" FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C5C6B9"/>
            <Setter Property="Background" Value="#182019"/>
            <Setter Property="BorderBrush" Value="#3B4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="#131713"/>
            <Setter Property="Background" Value="#D6C86A"/>
            <Setter Property="BorderBrush" Value="#D6C86A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89958B"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Foreground" Value="#DCE0C8"/>
            <Setter Property="Background" Value="#151B18"/>
            <Setter Property="BorderBrush" Value="#3A4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="DropdownBox" TargetType="Control" BasedOn="{StaticResource FieldBox}">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB7AB"/>
            <Setter Property="Background" Value="#1B2520"/>
            <Setter Property="BorderBrush" Value="#3A4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C5C6B9"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#89958B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Padding="16,10" Margin="0,0,2,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" TextElement.FontFamily="Consolas" TextElement.FontSize="11" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C5C6B9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#E8E6DA"/>
                                <Setter TargetName="Tab" Property="BorderBrush" Value="#D6C86A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Background="#182019" Foreground="#C5C6B9" Padding="6,2" BorderBrush="#344039" BorderThickness="0,0,0,1">
            <MenuItem Header="_File" Foreground="#C5C6B9">
                <MenuItem Header="_Open…" Click="Open_Click"/>
                <MenuItem Header="_Save" Click="Save_Click"/>
                <MenuItem Header="_Export…" Click="Export_Click"/>
                <Separator/>
                <MenuItem Header="Se_ttings…" Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" Foreground="#C5C6B9" SubmenuOpened="EditMenu_SubmenuOpened">
                <MenuItem x:Name="UndoMenuItem" Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem x:Name="RedoMenuItem" Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
            </MenuItem>
            <MenuItem Header="_View" Foreground="#C5C6B9">
                <MenuItem Header="Zoom _In" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom _Out" Click="ZoomOut_Click"/>
                <MenuItem Header="Zoom to _Fit / Reset View" Click="ViewFit_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools" Foreground="#C5C6B9">
                <MenuItem Header="_Body Studio…" Click="BodyStudio_Click"/>
                <MenuItem Header="LBA2: play _scene (the full engine)…" Click="Lba2Play_Click"/>
                <MenuItem Header="LBA2: scene e_ditor…" Click="Lba2Editor_Click"/>
                <MenuItem Header="LBA2: island _terrain editor…" Click="IslandEditor_Click"/>
                <MenuItem Header="LBA1 / LBA2: bricks and _sprites…" Click="AssetEditor_Click"/>
                <MenuItem Header="LBA1 / LBA2: _objects and bodies…" Click="ObjectBrowser_Click"/>
                <MenuItem Header="LBA1 / LBA2: interior _grid editor…" Click="GridEditor_Click"/>
                <Separator/>
                <MenuItem Header="LBA1: scene _editor…" Click="Lba1Editor_Click"/>
                <MenuItem Header="LBA1: _play scene…" Click="Lba1Play_Click"/>
                <MenuItem Header="LBA1: connect the _bedroom (scene 61) to Lupin Burg…" Click="Lba1RoomDoor_Click"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#141B19" BorderBrush="#344039" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="GAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="GameCombo" Style="{StaticResource DropdownBox}" Width="84" Padding="8,4" SelectionChanged="GameCombo_SelectionChanged">
                        <ComboBoxItem Content="LBA1" Tag="1"/>
                        <ComboBoxItem Content="LBA2" Tag="2" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="ISLAND" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="IslandCombo" Style="{StaticResource DropdownBox}" Width="210" Padding="8,4" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="SCENE" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SceneCombo" Style="{StaticResource DropdownBox}" Width="380" Padding="8,4" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"/>
                </StackPanel>
                <CheckBox x:Name="JoinAreasCheck" Grid.Column="3" Content="Join connected areas" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,16,7"
                          Foreground="#C5C6B9" Click="JoinAreas_Click"
                          ToolTip="LBA1: show scenes that join edge to edge (an island's outdoor areas) as one continuous map"/>
                <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentTitle" Text="Island" FontSize="16" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DocumentSummary" Text="" Foreground="#89958B" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="#151B1C">
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#344039" BorderThickness="0,0,0,1" Padding="16,0">
                    <DockPanel VerticalAlignment="Center">
                        <Button Content="▦" Click="Reset_Click" ToolTip="Reset view" Style="{StaticResource IconButton}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox x:Name="RotateViewCheckBox" Content="Rotate/tilt with mouse" IsChecked="True" Foreground="#AEB7AB" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox x:Name="SkyCheckBox" Content="Sky" IsChecked="True" Foreground="#AEB7AB" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0" Checked="SkyCheckBox_Changed" Unchecked="SkyCheckBox_Changed"/>
                            <Button Content="−" Click="ZoomOut_Click" Style="{StaticResource IconButton}"/>
                            <TextBox x:Name="ZoomLabel" Text="100%" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="8,0" Width="40" TextAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#AEB7AB" KeyDown="ZoomLabel_KeyDown" LostFocus="ZoomLabel_LostFocus" GotFocus="ZoomLabel_GotFocus"/>
                            <Button Content="+" Click="ZoomIn_Click" Style="{StaticResource IconButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Background="#151B1C" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                        <Grid x:Name="ViewportHost" Grid.Row="0" Grid.Column="0" ClipToBounds="True" SizeChanged="ViewportHost_SizeChanged" MouseWheel="TerrainViewport_MouseWheel" MouseRightButtonDown="TerrainViewport_MouseRightButtonDown">
                            <Image x:Name="TerrainViewport" Stretch="Fill" SnapsToDevicePixels="True" SizeChanged="TerrainViewport_SizeChanged" MouseDown="TerrainViewport_MouseDown" MouseMove="TerrainViewport_MouseMove" MouseUp="TerrainViewport_MouseUp" ClipToBounds="True" />
                            <Canvas x:Name="InteriorHost" Background="Transparent" Visibility="Collapsed" ClipToBounds="True" MouseDown="TerrainViewport_MouseDown" MouseMove="TerrainViewport_MouseMove" MouseUp="TerrainViewport_MouseUp">
                                <Image x:Name="InteriorViewImage" Stretch="None" SnapsToDevicePixels="False"/>
                            </Canvas>
                            <Canvas x:Name="ActorMarkerCanvas" IsHitTestVisible="True"/>
                        </Grid>
                        <ScrollBar x:Name="PanVerticalScrollBar" Grid.Row="0" Grid.Column="1" Orientation="Vertical"
                                   SmallChange="8192" LargeChange="65536"
                                   Scroll="PanVerticalScrollBar_Scroll"/>
                        <ScrollBar x:Name="PanHorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                                   SmallChange="8192" LargeChange="65536"
                                   Scroll="PanHorizontalScrollBar_Scroll"/>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="2" Background="#151B1C" LastChildFill="True" Margin="16,0">
                    <TextBlock x:Name="FileLabel" Text="" FontFamily="Consolas" FontSize="10" Foreground="#738076" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>

            <Border Grid.Column="1" BorderBrush="#344039" BorderThickness="1,0,0,0" Background="#141B19">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TabControl x:Name="SideTabs" Grid.Row="0" SelectionChanged="SideTabs_SelectionChanged">
                        <TabItem Header="ZONES">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20,18,20,18">
                                    <CheckBox x:Name="ZoneMasterCheck" Content="Show scene zones" IsChecked="True" Foreground="#E8E6DA" Click="ZoneMaster_Click"/>
                                    <CheckBox x:Name="PathsCheck" Content="Show actor paths" IsChecked="True" Foreground="#E8E6DA" Margin="0,10,0,0" Click="Paths_Click"/>
                                    <CheckBox x:Name="HighlightCheck" Content="Highlight selected actor / zone" IsChecked="True" Foreground="#E8E6DA" Margin="0,10,0,0" Click="Highlight_Click"/>
                                    <Separator Margin="0,14,0,14"/>
                                    <TextBlock Text="ZONE TYPES" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="ZoneTypeList"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="DETAILS" x:Name="ZoneDetailsTab">
                            <Grid Margin="16,14,16,10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="104"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="↻" Width="24" Height="20" Padding="0" Style="{StaticResource IconButton}" ToolTip="Refresh the list from what is in view" Click="ZoneListRefresh_Click"/>
                                    <TextBlock x:Name="ZoneListHeader" Text="ZONES IN VIEW" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ListBox x:Name="ZoneListBox" Grid.Row="1" Background="#0D1210" BorderBrush="#3A4740" Foreground="#DCE0C8" FontFamily="Consolas" FontSize="11"
                                         SelectionChanged="ZoneList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="4,2"/>
                                            <Setter Property="Foreground" Value="#DCE0C8"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#2C3D34"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1E2A24"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock x:Name="ZoneNoSelection" Text="Click a zone's outline in the map, or pick one from the list, to see and change its data." TextWrapping="Wrap"
                                                   Foreground="#78847B" FontFamily="Consolas" FontSize="10"/>
                                        <StackPanel x:Name="ZoneDetails" Visibility="Collapsed">
                                            <TextBlock x:Name="ZoneTitle" FontSize="15"/>
                                            <TextBlock x:Name="ZoneSubtitle" Foreground="#89958B" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10"/>

                                            <TextBlock Text="BOUNDS (SCENE UNITS)" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="3" Margin="0,0,0,2">
                                                <StackPanel Margin="0,0,4,0"><TextBlock Text="MIN X" Style="{StaticResource Eyebrow}"/><TextBox x:Name="MinXBox" Style="{StaticResource FieldBox}" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                                                <StackPanel Margin="0,0,4,0"><TextBlock Text="MIN Y" Style="{StaticResource Eyebrow}"/><TextBox x:Name="MinYBox" Style="{StaticResource FieldBox}" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                                                <StackPanel><TextBlock Text="MIN Z" Style="{StaticResource Eyebrow}"/><TextBox x:Name="MinZBox" Style="{StaticResource FieldBox}" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                                            </UniformGrid>
                                            <UniformGrid Columns="3" Margin="0,4,0,4">
                                                <StackPanel Margin="0,0,4,0"><TextBlock Text="MAX X" Style="{StaticResource Eyebrow}"/><TextBox x:Name="MaxXBox" Style="{StaticResource FieldBox}" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                                                <StackPanel Margin="0,0,4,0"><TextBlock Text="MAX Y" Style="{StaticResource Eyebrow}"/><TextBox x:Name="MaxYBox" Style="{StaticResource FieldBox}" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                                                <StackPanel><TextBlock Text="MAX Z" Style="{StaticResource Eyebrow}"/><TextBox x:Name="MaxZBox" Style="{StaticResource FieldBox}" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                                            </UniformGrid>
                                            <TextBlock x:Name="ZoneSizeText" FontFamily="Consolas" FontSize="11" Foreground="#C5C6B9" TextWrapping="Wrap" Margin="0,2,0,12"/>

                                            <TextBlock x:Name="ZoneDataHeader" Text="ZONE DATA" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                                            <StackPanel x:Name="ZoneFieldsPanel"/>
                                            <TextBlock x:Name="ZoneDestinationText" FontSize="11" Foreground="#D6C86A" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button x:Name="ZoneApplyButton" Content="Apply" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="ZoneApply_Click" ToolTip="Write these values into SCENE.HQR (the first save keeps SCENE.HQR.bak)"/>
                                                <Button x:Name="ZoneRevertButton" Content="Revert" Style="{StaticResource QuietButton}" Padding="12,6" Margin="8,0,0,0" Click="ZoneRevert_Click"/>
                                                <Button x:Name="ZoneGotoButton" Content="Go to destination" Style="{StaticResource QuietButton}" Padding="10,6" Margin="8,0,0,0" Click="ZoneGoto_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ZoneStatus" FontSize="11" Foreground="#89958B" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="BUILDING">
                            <StackPanel Margin="20,18,20,18">
                                <TextBlock Text="BUILDING" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Tools for placing bricks and building scenes will go here." TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" Foreground="#78847B" Margin="0,12,0,0"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="1" BorderBrush="#344039" BorderThickness="0,1,0,0" Padding="20,10,20,14">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="MinimapToggle" DockPanel.Dock="Right" Content="▾" Width="26" Height="22" Style="{StaticResource IconButton}" ToolTip="Collapse minimap" Click="MinimapToggle_Click"/>
                                <TextBlock Text="MINIMAP" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border x:Name="MinimapBody" Margin="0,10,0,0" Background="#0D1210" BorderBrush="#3A4740" BorderThickness="1" Padding="4">
                                <ScrollViewer x:Name="MinimapScrollViewer" Width="222" Height="222" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid Cursor="Hand" MouseLeftButtonDown="Minimap_MouseDown">
                                        <Image x:Name="MinimapImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Canvas x:Name="MinimapActorCanvas" IsHitTestVisible="False"/>
                                        <Canvas x:Name="MinimapMarkerCanvas" IsHitTestVisible="False"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
