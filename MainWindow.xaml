<Window x:Class="LBA2LevelEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LBA2LevelEditor"
        Title="LBA2 Level Workshop" Height="760" Width="1280" MinHeight="620" MinWidth="980"
        Background="#101418" Foreground="#E8E6DA" FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C5C6B9"/>
            <Setter Property="Background" Value="#182019"/>
            <Setter Property="BorderBrush" Value="#3B4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="#131713"/>
            <Setter Property="Background" Value="#D6C86A"/>
            <Setter Property="BorderBrush" Value="#D6C86A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89958B"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Foreground" Value="#DCE0C8"/>
            <Setter Property="Background" Value="#151B18"/>
            <Setter Property="BorderBrush" Value="#3A4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB7AB"/>
            <Setter Property="Background" Value="#1B2520"/>
            <Setter Property="BorderBrush" Value="#3A4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="LevelButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB7AB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,12"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#344039" BorderThickness="0,0,0,1" Background="#101418">
            <DockPanel Margin="28,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" Foreground="#D6C86A" FontSize="18" Margin="0,0,10,0"/>
                    <TextBlock Text="LBA2 / LEVEL WORKSHOP" FontFamily="Consolas" FontSize="11" Foreground="#D6C86A" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open" Click="Open_Click" Style="{StaticResource QuietButton}"/>
                    <Button Content="Save" Click="Save_Click" Style="{StaticResource QuietButton}"/>
                    <Button Content="Export" Click="Export_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
                <TextBlock x:Name="FileLabel" Text="●  DESERT.ILE" FontFamily="Consolas" FontSize="13" Foreground="#C5C6B9" VerticalAlignment="Center" Margin="34,0,0,0"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/><ColumnDefinition Width="246"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#344039" BorderThickness="0,0,1,0" Background="#141B19" Padding="20,30">
                <StackPanel>
                    <TextBlock Text="PROJECT BROWSER" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="DocumentTitle" Text="Island" FontSize="22" Margin="0,14,0,4"/>
                    <TextBlock x:Name="DocumentSummary" Text="Native ILE / 16 x 16 cubes" Foreground="#89958B" FontSize="12"/>
                    <Separator Margin="0,28,0,22"/>
                    <TextBlock Text="ISLANDS" Style="{StaticResource Eyebrow}"/>
                    <ListBox x:Name="IslandList" SelectionChanged="IslandList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="#AEB7AB" Margin="0,10,0,18"/>
                    <TextBlock Text="SCENES" Style="{StaticResource Eyebrow}"/>
                    <ListBox x:Name="SceneList" SelectionChanged="SceneList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="#AEB7AB" Height="120" Margin="0,10,0,0"/>
                    <TextBlock Text="▦   Source folder linked&#x0a;      E:\GOG Games\...\Levels" FontFamily="Consolas" FontSize="10" Foreground="#849087" Margin="0,44,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" Background="#151B1C">
                <Grid.RowDefinitions><RowDefinition Height="63"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#344039" BorderThickness="0,0,0,1" Padding="24,0">
                    <DockPanel VerticalAlignment="Center">
                        <Button Content="▦" Click="Reset_Click" ToolTip="Reset view" Style="{StaticResource IconButton}"/>
                        <TextBlock Text="PAINT TERRAIN" FontFamily="Consolas" FontSize="10" Foreground="#AEB7AB" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="−" Click="ZoomOut_Click" Style="{StaticResource IconButton}"/>
                            <TextBlock x:Name="ZoomLabel" Text="100%" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="8,0"/>
                            <Button Content="+" Click="ZoomIn_Click" Style="{StaticResource IconButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Background="#151B1C" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="TerrainViewport" Stretch="Fill" SnapsToDevicePixels="True" SizeChanged="TerrainViewport_SizeChanged" MouseDown="TerrainViewport_MouseDown" MouseMove="TerrainViewport_MouseMove" MouseUp="TerrainViewport_MouseUp" MouseWheel="TerrainViewport_MouseWheel" ClipToBounds="True" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Background="#CC101418" BorderBrush="#344039" BorderThickness="1" Padding="4">
                            <Grid Width="160" Height="160" Cursor="Hand" MouseLeftButtonDown="Minimap_MouseDown">
                                <Image x:Name="MinimapImage" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <Canvas x:Name="MinimapMarkerCanvas" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="2" Background="#151B1C" LastChildFill="True" Margin="24,0">
                    <TextBlock Text="3D VIEW / EDITABLE TERRAIN" FontFamily="Consolas" FontSize="10" Foreground="#738076" VerticalAlignment="Center"/>
                    <TextBlock Text="ORIGIN 0, 0" FontFamily="Consolas" FontSize="10" Foreground="#738076" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
            <Border Grid.Column="2" BorderBrush="#344039" BorderThickness="1,0,0,0" Background="#141B19" Padding="20,30">
                <StackPanel>
                    <TextBlock Text="TERRAIN PALETTE" Style="{StaticResource Eyebrow}"/>
                    <ItemsControl x:Name="Palette" Margin="0,14,0,22"/>
                    <Separator/>
                    <TextBlock Text="SELECTION" Style="{StaticResource Eyebrow}" Margin="0,22,0,0"/>
                    <TextBlock x:Name="SelectedLabel" Text="Grass / selected brush" FontSize="13" Margin="0,14,0,24"/>
                    <TextBlock Text="Tile height" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="0.0" IsReadOnly="True" Style="{StaticResource FieldBox}"/>
                    <TextBlock Text="Walkable" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <ComboBox SelectedIndex="0" Style="{StaticResource FieldBox}"><ComboBoxItem>Yes</ComboBoxItem><ComboBoxItem>No</ComboBoxItem></ComboBox>
                    <TextBlock Text="Native .ILE import and binary writing will plug into this panel." TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" Foreground="#78847B" Margin="0,28,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
