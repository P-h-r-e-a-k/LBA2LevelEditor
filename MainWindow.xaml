<Window x:Class="LBA2LevelEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LBA2LevelEditor"
        Title="LBA2 Level Workshop" Height="760" Width="1280" MinHeight="620" MinWidth="980"
        Background="#101418" Foreground="#E8E6DA" FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C5C6B9"/>
            <Setter Property="Background" Value="#182019"/>
            <Setter Property="BorderBrush" Value="#3B4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="#131713"/>
            <Setter Property="Background" Value="#D6C86A"/>
            <Setter Property="BorderBrush" Value="#D6C86A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89958B"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Foreground" Value="#DCE0C8"/>
            <Setter Property="Background" Value="#151B18"/>
            <Setter Property="BorderBrush" Value="#3A4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="DropdownBox" TargetType="Control" BasedOn="{StaticResource FieldBox}">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB7AB"/>
            <Setter Property="Background" Value="#1B2520"/>
            <Setter Property="BorderBrush" Value="#3A4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="LevelButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB7AB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,12"/>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C5C6B9"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Background="#182019" Foreground="#C5C6B9" Padding="6,2" BorderBrush="#344039" BorderThickness="0,0,0,1">
            <MenuItem Header="_File" Foreground="#C5C6B9">
                <MenuItem Header="_Open…" Click="Open_Click"/>
                <MenuItem Header="_Save" Click="Save_Click"/>
                <MenuItem Header="_Export…" Click="Export_Click"/>
                <Separator/>
                <MenuItem Header="Se_ttings…" Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_View" Foreground="#C5C6B9">
                <MenuItem Header="Zoom _In" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom _Out" Click="ZoomOut_Click"/>
                <MenuItem Header="Zoom to _Fit / Reset View" Click="ViewFit_Click"/>
                <Separator/>
                <MenuItem Header="_Zones">
                    <MenuItem Header="Show scene _zones" IsCheckable="True" IsChecked="True" Tag="all" Click="ZoneOptions_Changed"/>
                    <Separator/>
                    <MenuItem Header="Cube change" IsCheckable="True" IsChecked="False" Tag="0" Click="ZoneOptions_Changed"/>
                    <MenuItem Header="Camera" IsCheckable="True" IsChecked="False" Tag="1" Click="ZoneOptions_Changed"/>
                    <MenuItem Header="Scenaric" IsCheckable="True" IsChecked="True" Tag="2" Click="ZoneOptions_Changed"/>
                    <MenuItem Header="Grid" IsCheckable="True" IsChecked="True" Tag="3" Click="ZoneOptions_Changed"/>
                    <MenuItem Header="Giver" IsCheckable="True" IsChecked="True" Tag="4" Click="ZoneOptions_Changed"/>
                    <MenuItem Header="Message" IsCheckable="True" IsChecked="True" Tag="5" Click="ZoneOptions_Changed"/>
                    <MenuItem Header="Ladder" IsCheckable="True" IsChecked="True" Tag="6" Click="ZoneOptions_Changed"/>
                    <MenuItem Header="Escalator" IsCheckable="True" IsChecked="True" Tag="7" Click="ZoneOptions_Changed"/>
                    <MenuItem Header="Hit" IsCheckable="True" IsChecked="True" Tag="8" Click="ZoneOptions_Changed"/>
                    <MenuItem Header="Rail" IsCheckable="True" IsChecked="True" Tag="9" Click="ZoneOptions_Changed"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools" Foreground="#C5C6B9">
                <MenuItem Header="_Body Studio…" Click="BodyStudio_Click"/>
            </MenuItem>
        </Menu>
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#344039" BorderThickness="0,0,0,1" Background="#101418">
            <DockPanel Margin="28,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" Foreground="#D6C86A" FontSize="18" Margin="0,0,10,0"/>
                    <TextBlock Text="LBA2 / LEVEL WORKSHOP" FontFamily="Consolas" FontSize="11" Foreground="#D6C86A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="FileLabel" Text="●  DESERT.ILE" FontFamily="Consolas" FontSize="13" Foreground="#C5C6B9" VerticalAlignment="Center" Margin="34,0,0,0"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/><ColumnDefinition Width="268"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#344039" BorderThickness="0,0,1,0" Background="#141B19" Padding="20,30">
                <StackPanel>
                    <TextBlock Text="PROJECT BROWSER" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="DocumentTitle" Text="Island" FontSize="22" Margin="0,14,0,4"/>
                    <TextBlock x:Name="DocumentSummary" Text="Native ILE / 16 x 16 cubes" Foreground="#89958B" FontSize="12"/>
                    <Separator Margin="0,28,0,22"/>
                    <TextBlock Text="ISLAND" Style="{StaticResource Eyebrow}"/>
                    <ComboBox x:Name="IslandCombo" Style="{StaticResource DropdownBox}" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" Margin="0,10,0,18"/>
                    <TextBlock Text="SCENE" Style="{StaticResource Eyebrow}"/>
                    <ComboBox x:Name="SceneCombo" Style="{StaticResource DropdownBox}" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" Margin="0,10,0,0"/>
                    <TextBlock Text="▦   Source folder linked&#x0a;      E:\GOG Games\...\Levels" FontFamily="Consolas" FontSize="10" Foreground="#849087" Margin="0,44,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" Background="#151B1C">
                <Grid.RowDefinitions><RowDefinition Height="63"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#344039" BorderThickness="0,0,0,1" Padding="24,0">
                    <DockPanel VerticalAlignment="Center">
                        <Button Content="▦" Click="Reset_Click" ToolTip="Reset view" Style="{StaticResource IconButton}"/>
                        <TextBlock Text="PAINT TERRAIN" FontFamily="Consolas" FontSize="10" Foreground="#AEB7AB" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox x:Name="RotateViewCheckBox" Content="Rotate/tilt with mouse" IsChecked="True" Foreground="#AEB7AB" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox x:Name="SkyCheckBox" Content="Sky" IsChecked="True" Foreground="#AEB7AB" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0" Checked="SkyCheckBox_Changed" Unchecked="SkyCheckBox_Changed"/>
                            <Button Content="−" Click="ZoomOut_Click" Style="{StaticResource IconButton}"/>
                            <TextBox x:Name="ZoomLabel" Text="100%" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="8,0" Width="40" TextAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#AEB7AB" KeyDown="ZoomLabel_KeyDown" LostFocus="ZoomLabel_LostFocus" GotFocus="ZoomLabel_GotFocus"/>
                            <Button Content="+" Click="ZoomIn_Click" Style="{StaticResource IconButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Background="#151B1C" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                        <Grid x:Name="ViewportHost" Grid.Row="0" Grid.Column="0" ClipToBounds="True" SizeChanged="ViewportHost_SizeChanged" MouseWheel="TerrainViewport_MouseWheel" MouseRightButtonDown="TerrainViewport_MouseRightButtonDown">
                            <Image x:Name="TerrainViewport" Stretch="Fill" SnapsToDevicePixels="True" SizeChanged="TerrainViewport_SizeChanged" MouseDown="TerrainViewport_MouseDown" MouseMove="TerrainViewport_MouseMove" MouseUp="TerrainViewport_MouseUp" ClipToBounds="True" />
                            <Canvas x:Name="InteriorHost" Background="Transparent" Visibility="Collapsed" ClipToBounds="True" MouseDown="TerrainViewport_MouseDown" MouseMove="TerrainViewport_MouseMove" MouseUp="TerrainViewport_MouseUp">
                                <Image x:Name="InteriorViewImage" Stretch="None" SnapsToDevicePixels="False"/>
                            </Canvas>
                            <Canvas x:Name="ActorMarkerCanvas" IsHitTestVisible="True"/>
                        </Grid>
                        <ScrollBar x:Name="PanVerticalScrollBar" Grid.Row="0" Grid.Column="1" Orientation="Vertical"
                                   SmallChange="8192" LargeChange="65536"
                                   Scroll="PanVerticalScrollBar_Scroll"/>
                        <ScrollBar x:Name="PanHorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                                   SmallChange="8192" LargeChange="65536"
                                   Scroll="PanHorizontalScrollBar_Scroll"/>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="2" Background="#151B1C" LastChildFill="True" Margin="24,0">
                    <TextBlock Text="3D VIEW / EDITABLE TERRAIN" FontFamily="Consolas" FontSize="10" Foreground="#738076" VerticalAlignment="Center"/>
                    <TextBlock Text="ORIGIN 0, 0" FontFamily="Consolas" FontSize="10" Foreground="#738076" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
            <Border Grid.Column="2" BorderBrush="#344039" BorderThickness="1,0,0,0" Background="#141B19" Padding="20,30">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="TerrainPalettePanel">
                        <TextBlock Text="TERRAIN PALETTE" Style="{StaticResource Eyebrow}"/>
                        <ItemsControl x:Name="Palette" Margin="0,14,0,22"/>
                        <Separator/>
                        <TextBlock Text="SELECTION" Style="{StaticResource Eyebrow}" Margin="0,22,0,0"/>
                        <TextBlock x:Name="SelectedLabel" Text="Grass / selected brush" FontSize="13" Margin="0,14,0,24"/>
                        <TextBlock Text="Tile height" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="0.0" IsReadOnly="True" Style="{StaticResource FieldBox}"/>
                        <TextBlock Text="Walkable" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                        <ComboBox SelectedIndex="0" Style="{StaticResource DropdownBox}"><ComboBoxItem>Yes</ComboBoxItem><ComboBoxItem>No</ComboBoxItem></ComboBox>
                        <TextBlock Text="Native .ILE import and binary writing will plug into this panel." TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" Foreground="#78847B" Margin="0,28,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="MinimapPanel">
                        <Separator Margin="0,22,0,0"/>
                        <TextBlock Text="MINIMAP" Style="{StaticResource Eyebrow}" Margin="0,22,0,14"/>
                        <Border Margin="0,0,0,22" Background="#0D1210" BorderBrush="#3A4740" BorderThickness="1" Padding="4">
                            <ScrollViewer x:Name="MinimapScrollViewer" Width="222" Height="222" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Grid Cursor="Hand" MouseLeftButtonDown="Minimap_MouseDown">
                                    <Image x:Name="MinimapImage" Stretch="None" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Canvas x:Name="MinimapActorCanvas" IsHitTestVisible="False"/>
                                    <Canvas x:Name="MinimapMarkerCanvas" IsHitTestVisible="False"/>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
