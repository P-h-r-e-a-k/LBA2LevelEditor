<Window x:Class="LBAAssembler.MinimapPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minimap" Height="520" Width="520" MinHeight="240" MinWidth="240"
        Background="{DynamicResource ThemeWindowBrush}" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Border Margin="12" Background="Black" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Grid x:Name="PopupContent" Cursor="Hand" MouseLeftButtonDown="PopupContent_MouseLeftButtonDown">
            <Image x:Name="PopupImage" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
    </Border>
</Window>
