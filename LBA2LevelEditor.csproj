<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      LBA Body Studio (BodyStudio/*.cs, absorbed from the standalone
      LbaBodyStudio project) is a Windows Forms app: .NET lets a single
      project host both UI stacks side by side, so ActorAttributesWindow
      (WPF) can launch its MainForm (WinForms) directly in-process rather
      than shelling out to a separate exe.
    -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!--
    UseWindowsForms's own implicit global usings (System.Drawing,
    System.Windows.Forms) collide with the WPF codebase's own bare Color/
    Point/ComboBox/TextBox/Application/Brush/KeyEventArgs/MouseEventArgs/
    ScrollEventArgs (all ambiguous against the System.Windows.* equivalent)
    the moment both UI stacks share one project, so they're removed here to
    restore the plain-WPF ambient set every existing file already assumed.
    BodyStudio's own files (which do need System.Drawing/System.Windows.Forms)
    just say so explicitly instead of relying on an implicit global using.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!--
    liblba2_renderer.dll (built from native/lba2-classic-community with the
    LBA2_LINK_STATIC CMake option ON, in the separate
    out/build/windows_ucrt64_static tree kept apart from the fast
    iterating out/build/windows_ucrt64 dev build) is made available to the
    app two ways:

    - Copied next to the exe on every build (None+CopyToOutputDirectory),
      for a normal dotnet build/run or a folder based dotnet publish.
      RendererLibraryApi checks there first since it's the cheapest case
      with no extraction needed.

    - Embedded as a resource, for a single file publish
      (PublishSingleFile=true). dotnet publish's IncludeNativeLibrariesFor
      SelfExtract option looked like the built in answer for this, but it
      turned out not to be: it does extract the DLL correctly at runtime,
      just into its own private per app, per hash cache directory under
      the temp folder rather than next to the exe, since AppContext.
      BaseDirectory stays the exe's own folder for a single file app, and
      NativeLibrary.Load resolving a bare "liblba2_renderer.dll" does not
      search that directory either, confirmed by a DllNotFoundException
      there. Embedding it ourselves and extracting it to a location we
      choose (RendererLibraryApi does this, under the local application
      data folder) sidesteps that entirely instead of fighting the single
      file host's own resolver.
  -->
  <ItemGroup>
    <None Include="native\lba2-classic-community\out\build\windows_ucrt64_static\SOURCES\3DEXT\liblba2_renderer.dll"
          Condition="Exists('native\lba2-classic-community\out\build\windows_ucrt64_static\SOURCES\3DEXT\liblba2_renderer.dll')"
          Link="liblba2_renderer.dll" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="native\lba2-classic-community\out\build\windows_ucrt64_static\SOURCES\3DEXT\liblba2_renderer.dll"
          Condition="Exists('native\lba2-classic-community\out\build\windows_ucrt64_static\SOURCES\3DEXT\liblba2_renderer.dll')"
          LogicalName="liblba2_renderer.dll" />
  </ItemGroup>

  <!--
    Dummy body shown in the Actor Attributes preview panel for a freshly
    added actor that hasn't had a real body applied yet (see
    ActorAttributesWindow's showingDummyBody): a real LBA2 body payload
    (Body.Read/Renderer.Render from BodyStudio parse and draw it directly),
    not a body actually installed into BODY.HQR. The native renderer only
    ever resolves GenBody through the installed archive, and this editor
    has no business rewriting the user's game files just to give a new
    actor a nicer-looking placeholder.
  -->
  <ItemGroup>
    <Content Include="Assets\DummyBody.lm2" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
