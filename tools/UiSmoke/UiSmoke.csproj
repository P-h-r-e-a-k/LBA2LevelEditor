<Project Sdk="Microsoft.NET.Sdk">

  <!-- Parses the app's XAML at runtime (styles, templates, triggers) so a bad property name shows up here instead of when a window is first opened. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
