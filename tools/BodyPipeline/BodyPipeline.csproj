<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console harness for the body <-> flat image pipeline: statistics over the game's own bodies, flat reference sheets of them,
    game-style conversion of artwork, and the round trip body -> sheet -> generated body. Compiles Body Studio's sources directly.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BodyPipeline</RootNamespace>
    <NoWarn>CS8618;CS8600;CS8602;CS8604;CS0649;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\BodyStudio\**\*.cs" Link="BodyStudio\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\EditorSettings.cs" Link="EditorSettings.cs" />
    <Compile Include="..\..\Lba2Engine.cs" Link="Lba2Engine.cs" />
    <Compile Include="..\..\LbaScript\**\*.cs" Link="LbaScript\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
