<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The editor's original, default theme: exactly the palette every window already used before
         theming existed, now just relocated here so it's one option among several instead of the only
         one. See ThemeManager.cs for how a theme dictionary like this one gets swapped in. -->
    <Color x:Key="ThemeField">#FFFFFF</Color>
    <Color x:Key="ThemeWindow">#E8F0FA</Color>
    <Color x:Key="ThemeSurface">#F3F8FF</Color>
    <Color x:Key="ThemeRaised">#D6E6F7</Color>
    <Color x:Key="ThemeHover">#C3DBF5</Color>
    <Color x:Key="ThemeSelected">#1B6EC2</Color>
    <Color x:Key="ThemeBorder">#A9C3E0</Color>
    <Color x:Key="ThemeButtonBorder">#9FBEE0</Color>
    <Color x:Key="ThemeBorderStrong">#8FB0D6</Color>
    <Color x:Key="ThemeText">#10243E</Color>
    <Color x:Key="ThemeTextMuted">#4E6B8A</Color>
    <Color x:Key="ThemeTextMuted2">#234A72</Color>
    <Color x:Key="ThemeDisabled">#7C93AC</Color>
    <Color x:Key="ThemeAccent">#1B6EC2</Color>
    <!-- The text/icon colour to use ON a ThemeAccent-coloured background (a primary button, a selected
         list row): themed separately from everything else because it must stay readable against
         whatever Accent happens to be in each theme, and that isn't always a colour white text suits.
         High Contrast Dark's Accent is bright yellow, where white text would be nearly as poor a match
         as black-on-black. -->
    <Color x:Key="ThemeAccentText">#FFFFFF</Color>
    <Color x:Key="ThemeMenu">#DCEAFA</Color>
    <Color x:Key="ThemeRowEven">#EAF3FD</Color>
    <Color x:Key="ThemeHeader">#D2E3F6</Color>
    <Color x:Key="ThemeSuccess">#14664A</Color>
    <Color x:Key="ThemeWarning">#A32C22</Color>
    <Color x:Key="ThemeError">#E08A6A</Color>

    <SolidColorBrush x:Key="ThemeFieldBrush" Color="{StaticResource ThemeField}"/>
    <SolidColorBrush x:Key="ThemeWindowBrush" Color="{StaticResource ThemeWindow}"/>
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{StaticResource ThemeSurface}"/>
    <SolidColorBrush x:Key="ThemeRaisedBrush" Color="{StaticResource ThemeRaised}"/>
    <SolidColorBrush x:Key="ThemeHoverBrush" Color="{StaticResource ThemeHover}"/>
    <SolidColorBrush x:Key="ThemeSelectedBrush" Color="{StaticResource ThemeSelected}"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorder}"/>
    <SolidColorBrush x:Key="ThemeButtonBorderBrush" Color="{StaticResource ThemeButtonBorder}"/>
    <SolidColorBrush x:Key="ThemeBorderStrongBrush" Color="{StaticResource ThemeBorderStrong}"/>
    <SolidColorBrush x:Key="ThemeTextBrush" Color="{StaticResource ThemeText}"/>
    <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="{StaticResource ThemeTextMuted}"/>
    <SolidColorBrush x:Key="ThemeTextMuted2Brush" Color="{StaticResource ThemeTextMuted2}"/>
    <SolidColorBrush x:Key="ThemeDisabledBrush" Color="{StaticResource ThemeDisabled}"/>
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource ThemeAccent}"/>
    <SolidColorBrush x:Key="ThemeAccentTextBrush" Color="{StaticResource ThemeAccentText}"/>
    <SolidColorBrush x:Key="ThemeMenuBrush" Color="{StaticResource ThemeMenu}"/>
    <SolidColorBrush x:Key="ThemeRowEvenBrush" Color="{StaticResource ThemeRowEven}"/>
    <SolidColorBrush x:Key="ThemeHeaderBrush" Color="{StaticResource ThemeHeader}"/>
    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="{StaticResource ThemeSuccess}"/>
    <SolidColorBrush x:Key="ThemeWarningBrush" Color="{StaticResource ThemeWarning}"/>
    <SolidColorBrush x:Key="ThemeErrorBrush" Color="{StaticResource ThemeError}"/>

    <!-- The breakpoint/debug banner (ActorScriptWindow): a fixed-looking "flagged" highlight, kept as
         its own small palette rather than reusing Warning/Error, since its role (a paused-script marker)
         isn't a severity level. -->
    <Color x:Key="ThemeFlagBg">#FDECC8</Color>
    <Color x:Key="ThemeFlagBorder">#D9A93B</Color>
    <Color x:Key="ThemeFlagText">#5A4310</Color>
    <SolidColorBrush x:Key="ThemeFlagBgBrush" Color="{StaticResource ThemeFlagBg}"/>
    <SolidColorBrush x:Key="ThemeFlagBorderBrush" Color="{StaticResource ThemeFlagBorder}"/>
    <SolidColorBrush x:Key="ThemeFlagTextBrush" Color="{StaticResource ThemeFlagText}"/>
</ResourceDictionary>
