<Window x:Class="LBA2LevelEditor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="380" Width="620" MinHeight="380" MinWidth="560"
        Background="#101418" Foreground="#E8E6DA" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C5C6B9"/>
            <Setter Property="Background" Value="#182019"/>
            <Setter Property="BorderBrush" Value="#3B4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="#131713"/>
            <Setter Property="Background" Value="#D6C86A"/>
            <Setter Property="BorderBrush" Value="#D6C86A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89958B"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Foreground" Value="#DCE0C8"/>
            <Setter Property="Background" Value="#151B18"/>
            <Setter Property="BorderBrush" Value="#3A4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="LBA2 GAME FOLDER  (optional)" Style="{StaticResource Eyebrow}"/>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="Browse..." Click="Browse_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/>
            <TextBox x:Name="GameDirectoryBox" Style="{StaticResource FieldBox}" VerticalContentAlignment="Center"/>
        </DockPanel>

        <TextBlock Grid.Row="4" Text="Folder containing the .ILE islands, RESS.HQR, SCENE.HQR, etc. Leave blank if you only have LBA1." TextWrapping="Wrap" FontSize="11" Foreground="#738076"/>
        <TextBlock x:Name="ValidationText" Grid.Row="0" Text="" FontSize="11" Foreground="#E08A6A" HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="6" Text="LBA1 GAME FOLDER  (optional)" Style="{StaticResource Eyebrow}"/>

        <DockPanel Grid.Row="8">
            <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseLba1_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/>
            <TextBox x:Name="Lba1DirectoryBox" Style="{StaticResource FieldBox}" VerticalContentAlignment="Center"/>
        </DockPanel>

        <TextBlock Grid.Row="10" Text="Folder containing SCENE.HQR, LBA_GRI.HQR, LBA_BLL.HQR, LBA_BRK.HQR, RESS.HQR. Leave blank if you only have LBA2." TextWrapping="Wrap" FontSize="11" Foreground="#738076"/>
        <TextBlock x:Name="Lba1ValidationText" Grid.Row="6" Text="" FontSize="11" Foreground="#E08A6A" HorizontalAlignment="Right"/>

        <CheckBox Grid.Row="11" x:Name="LowercaseNamesCheck" VerticalAlignment="Top" Margin="0,22,0,0" Foreground="#C5C6B9"
                  Content="Lowercase function names in script text (set_track(…) instead of SET_TRACK(…))"/>

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource QuietButton}" Margin="0"/>
            <Button Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
