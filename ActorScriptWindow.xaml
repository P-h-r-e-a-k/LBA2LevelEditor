<Window x:Class="LBA2LevelEditor.ActorScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actor Script" Height="760" Width="1180" MinHeight="420" MinWidth="820"
        Background="#101418" Foreground="#E8E6DA" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89958B"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Foreground" Value="#DCE0C8"/>
            <Setter Property="Background" Value="#151B18"/>
            <Setter Property="BorderBrush" Value="#3A4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Text="ACTOR SCRIPT" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="TitleLabel" Text="Actor 0" FontSize="19" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#151B18" BorderBrush="#3A4740" BorderThickness="1" Padding="12,10">
            <TextBlock x:Name="StatsLabel" Text="" FontFamily="Consolas" FontSize="11" Foreground="#AEB7AB" TextWrapping="Wrap"/>
        </Border>

        <DockPanel Grid.Row="4" Grid.Column="0">
            <TextBlock Text="SCRIPT" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
            <TextBlock Text="editing here does not save back to the game files yet"
                       Foreground="#89958B" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock DockPanel.Dock="Right" Text="Ctrl+Space for suggestions"
                       Foreground="#5C6B60" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Grid.Row="4" Grid.Column="2" Text="KEYWORDS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>

        <Grid Grid.Row="6" Grid.Column="0">
            <TextBox x:Name="ScriptTextBox"
                     AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="13" Foreground="#DCE0C8" Background="#0D1210"
                     BorderBrush="#3A4740" BorderThickness="1" Padding="10"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextChanged="ScriptTextBox_TextChanged"
                     PreviewKeyDown="ScriptTextBox_PreviewKeyDown"
                     LostKeyboardFocus="ScriptTextBox_LostKeyboardFocus"/>

            <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=ScriptTextBox}"
                   Placement="RelativePoint" StaysOpen="False" AllowsTransparency="True" Focusable="False">
                <Border Background="#181F1B" BorderBrush="#4A5A50" BorderThickness="1" MaxHeight="280" MinWidth="360" MaxWidth="520">
                    <ListBox x:Name="SuggestionList" Background="Transparent" BorderThickness="0"
                             Foreground="#DCE0C8" FontFamily="Consolas" FontSize="12"
                             PreviewMouseLeftButtonUp="SuggestionList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,5">
                                    <TextBlock Text="{Binding Signature}" FontWeight="Bold" Foreground="#D6C86A"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#9AA69C" FontSize="10" TextWrapping="Wrap" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>

        <!-- Full reference list of every valid script keyword (life actions,
             life conditions, comparisons, track actions), separate from the
             in-editor autocomplete popup above: browsable/searchable on its
             own rather than only appearing while actively typing a matching
             prefix. Double-click or Enter inserts at the caret. -->
        <Grid Grid.Row="6" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="KeywordFilterBox" Grid.Row="0" Style="{StaticResource FieldBox}"
                     TextChanged="KeywordFilterBox_TextChanged" KeyDown="KeywordFilterBox_KeyDown"/>
            <TextBlock x:Name="KeywordFilterPlaceholder" Grid.Row="0" Text="Filter keywords…" Foreground="#5C6B60"
                       FontFamily="Consolas" FontSize="12" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <ListBox x:Name="KeywordList" Grid.Row="2" Background="#0D1210" BorderBrush="#3A4740" BorderThickness="1"
                     Foreground="#DCE0C8" FontFamily="Consolas" FontSize="12"
                     MouseDoubleClick="KeywordList_MouseDoubleClick" KeyDown="KeywordList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,4" ToolTip="{Binding Description}">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#D6C86A"/>
                            <TextBlock Text="{Binding Kind}" Foreground="#78847B" FontSize="9" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
