<Window x:Class="LBA2LevelEditor.Lba1SceneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LBA1 - scene editor" Width="1400" Height="860" MinWidth="900" MinHeight="520"
        Background="#FFFFFF" Foreground="#10243E" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#10243E"/>
            <Setter Property="Background" Value="#D6E6F7"/>
            <Setter Property="BorderBrush" Value="#A9C3E0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#10243E"/>
            <Setter Property="BorderBrush" Value="#A9C3E0"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="CaretBrush" Value="#10243E"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#10243E"/>
            <Setter Property="BorderBrush" Value="#A9C3E0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="#4E6B8A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#D6E6F7" BorderBrush="#A9C3E0" BorderThickness="0,0,0,1" Padding="12,8,12,4">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Scene" Foreground="#4E6B8A" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <ComboBox x:Name="SceneCombo" Width="300" Margin="0,0,10,4" SelectionChanged="SceneCombo_SelectionChanged"/>
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click"/>
                <Button x:Name="RevertButton" Content="Revert" Click="Revert_Click"/>
                <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click"/>
                <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click"/>
                <Button x:Name="AddButton" Content="Add ▾" Click="Add_Click"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click"/>
                <Button x:Name="DuplicateButton" Content="Duplicate" Click="Duplicate_Click"/>
                <Button x:Name="PlayButton" Content="Play scene" Click="Play_Click"/>
                <Button x:Name="ScenePlusButton" Content="Scene ▾" Click="ScenePlus_Click"/>
                <CheckBox x:Name="ZonesCheck" Content="Zones" IsChecked="True" Foreground="#10243E" Margin="8,3,10,0" Click="View_Click"/>
                <CheckBox x:Name="ActorsCheck" Content="Actors" IsChecked="True" Foreground="#10243E" Margin="0,3,10,0" Click="View_Click"/>
                <CheckBox x:Name="PointsCheck" Content="Track points" IsChecked="True" Foreground="#10243E" Margin="0,3,10,0" Click="View_Click"/>
                <TextBlock Text="Zoom" Foreground="#4E6B8A" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <Slider x:Name="ZoomSlider" Minimum="0.4" Maximum="2.5" Value="1" Width="100" VerticalAlignment="Center" Margin="0,0,0,4" ValueChanged="Zoom_ValueChanged"/>
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E8F0FA" BorderBrush="#A9C3E0" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="StatusText" Foreground="#10243E" FontSize="11.5" TextWrapping="Wrap"/>
        </Border>
        <Border DockPanel.Dock="Left" Width="290" Background="#E8F0FA" BorderBrush="#A9C3E0" BorderThickness="0,0,1,0" Padding="10,8">
            <TabControl x:Name="ListTabs" Background="Transparent" BorderThickness="0" SelectionChanged="ListTabs_SelectionChanged">
                <TabItem Header="Actors"><ListBox x:Name="ActorList" SelectionChanged="ActorList_SelectionChanged" MouseDoubleClick="ActorList_DoubleClick"/></TabItem>
                <TabItem Header="Zones"><ListBox x:Name="ZoneList" SelectionChanged="ZoneList_SelectionChanged"/></TabItem>
                <TabItem Header="Points"><ListBox x:Name="PointList" SelectionChanged="PointList_SelectionChanged"/></TabItem>
                <TabItem Header="Scene"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HeaderPanel" Margin="0,4,6,0"/></ScrollViewer></TabItem>
            </TabControl>
        </Border>
        <Border DockPanel.Dock="Right" Width="330" Background="#E8F0FA" BorderBrush="#A9C3E0" BorderThickness="1,0,0,0" Padding="12,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="InspectorTitle" FontSize="13" FontWeight="SemiBold" Foreground="#10243E" TextWrapping="Wrap"/>
                    <TextBlock x:Name="InspectorNote" Foreground="#4E6B8A" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <Grid x:Name="InspectorGrid"/>
                    <WrapPanel x:Name="InspectorButtons" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="MapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFFFFF" Focusable="False">
            <Grid x:Name="MapHost" Background="#FFFFFF" MouseLeftButtonDown="Map_MouseLeftButtonDown" MouseMove="Map_MouseMove" MouseLeftButtonUp="Map_MouseLeftButtonUp">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Image x:Name="MapImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Canvas x:Name="OverlayCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
