<Window x:Class="LBAAssembler.Lba2SceneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LBA2 - scene editor" Width="1400" Height="860" MinWidth="900" MinHeight="520"
        Background="{DynamicResource ThemeFieldBrush}" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextBrush}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeRaisedBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8,12,4">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Scene" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <ComboBox x:Name="SceneCombo" Width="320" Margin="0,0,10,4" SelectionChanged="SceneCombo_SelectionChanged"/>
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click"/>
                <Button x:Name="RevertButton" Content="Revert" Click="Revert_Click"/>
                <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click"/>
                <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click"/>
                <Button x:Name="AddButton" Content="Add ▾" Click="Add_Click"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click"/>
                <Button x:Name="DuplicateButton" Content="Duplicate" Click="Duplicate_Click"/>
                <Button x:Name="PlayButton" Content="Play scene" Click="Play_Click"/>
                <Button x:Name="ScenePlusButton" Content="Scene ▾" Click="ScenePlus_Click"/>
                <CheckBox x:Name="ZonesCheck" Content="Zones" IsChecked="True" Foreground="{DynamicResource ThemeTextBrush}" Margin="8,3,10,0" Click="View_Click"/>
                <CheckBox x:Name="ActorsCheck" Content="Actors" IsChecked="True" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,3,10,0" Click="View_Click"/>
                <CheckBox x:Name="PointsCheck" Content="Track points" IsChecked="True" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,3,10,0" Click="View_Click"/>
                <TextBlock Text="Zoom" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <Slider x:Name="ZoomSlider" Minimum="0.3" Maximum="3" Value="1" Width="100" VerticalAlignment="Center" Margin="0,0,0,4" ValueChanged="Zoom_ValueChanged"/>
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemeWindowBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource ThemeTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
        </Border>
        <Border DockPanel.Dock="Left" Width="290" Background="{DynamicResource ThemeWindowBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8">
            <TabControl x:Name="ListTabs" Background="Transparent" BorderThickness="0">
                <TabItem Header="Actors"><ListBox x:Name="ActorList" SelectionChanged="ActorList_SelectionChanged"/></TabItem>
                <TabItem Header="Zones"><ListBox x:Name="ZoneList" SelectionChanged="ZoneList_SelectionChanged"/></TabItem>
                <TabItem Header="Points"><ListBox x:Name="PointList" SelectionChanged="PointList_SelectionChanged"/></TabItem>
                <TabItem Header="Scene"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HeaderPanel" Margin="0,4,6,0"/></ScrollViewer></TabItem>
            </TabControl>
        </Border>
        <Border DockPanel.Dock="Right" Width="330" Background="{DynamicResource ThemeWindowBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1,0,0,0" Padding="12,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="InspectorTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="InspectorNote" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <Grid x:Name="InspectorGrid"/>
                    <WrapPanel x:Name="InspectorButtons" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <!-- the plan: the scene seen from above, x to the right and z down, in world units -->
        <ScrollViewer x:Name="MapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource ThemeFieldBrush}" Focusable="False">
            <Grid x:Name="MapHost" Background="{DynamicResource ThemeFieldBrush}" MouseLeftButtonDown="Map_MouseLeftButtonDown" MouseMove="Map_MouseMove" MouseLeftButtonUp="Map_MouseLeftButtonUp" MouseRightButtonDown="Map_MouseRightButtonDown">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Canvas x:Name="PlanCanvas" Width="1024" Height="1024" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
