<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    LBA Body Studio (BodyStudio/*.cs, absorbed from the standalone LbaBodyStudio project) used to be a
    Windows Forms app (MainForm.cs/AnimationStudioForm.cs); both were ported to plain WPF windows for the
    Interface Audit's "two windows are genuinely WinForms in a WPF app" finding (BodyStudioWindow.cs/
    AnimationStudioWindow.cs), so UseWindowsForms and its own implicit-global-using workaround (System.
    Drawing/System.Windows.Forms collided with the WPF codebase's own bare Color/Point/ComboBox/TextBox/
    Application/Brush ambient set) are gone with it. Renderer.cs's own rasterizer still uses System.Drawing
    (Bitmap/Graphics/Color, converted to a WPF BitmapSource only at the ModelView boundary, see its own
    comment), which is a plain data/2D-drawing library, not WinForms, and stays available without this flag.
  -->

  <!-- tools/ holds separate console harnesses (each its own project); keep their sources and obj output out of the app. -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
    <Page Remove="tools\**" />
  </ItemGroup>

  <!--
    liblba2_renderer.dll (built from native/lba2-classic-community with the
    LBA2_LINK_STATIC CMake option ON, in the separate
    out/build/windows_ucrt64_static tree kept apart from the fast
    iterating out/build/windows_ucrt64 dev build) is made available to the
    app two ways:

    - Copied next to the exe on every build (None+CopyToOutputDirectory),
      for a normal dotnet build/run or a folder based dotnet publish.
      RendererLibraryApi checks there first since it's the cheapest case
      with no extraction needed.

    - Embedded as a resource, for a single file publish
      (PublishSingleFile=true). dotnet publish's IncludeNativeLibrariesFor
      SelfExtract option looked like the built in answer for this, but it
      turned out not to be: it does extract the DLL correctly at runtime,
      just into its own private per app, per hash cache directory under
      the temp folder rather than next to the exe, since AppContext.
      BaseDirectory stays the exe's own folder for a single file app, and
      NativeLibrary.Load resolving a bare "liblba2_renderer.dll" does not
      search that directory either, confirmed by a DllNotFoundException
      there. Embedding it ourselves and extracting it to a location we
      choose (RendererLibraryApi does this, in a native folder next to the
      exe, falling back to the local application data folder) sidesteps that entirely instead of fighting the single
      file host's own resolver.
  -->
  <ItemGroup>
    <None Include="native\lba2-classic-community\out\build\windows_ucrt64_static\SOURCES\3DEXT\liblba2_renderer.dll"
          Condition="Exists('native\lba2-classic-community\out\build\windows_ucrt64_static\SOURCES\3DEXT\liblba2_renderer.dll')"
          Link="liblba2_renderer.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="native\lba2-classic-community\out\build\windows_ucrt64_static\SOURCES\3DEXT\liblba2_renderer.dll"
          Condition="Exists('native\lba2-classic-community\out\build\windows_ucrt64_static\SOURCES\3DEXT\liblba2_renderer.dll')"
          LogicalName="liblba2_renderer.dll" />
  </ItemGroup>

  <!--
    Dummy body shown in the Actor Attributes preview panel for a freshly
    added actor that hasn't had a real body applied yet (see
    ActorAttributesWindow's showingDummyBody): a real LBA2 body payload
    (Body.Read/Renderer.Render from BodyStudio parse and draw it directly),
    not a body actually installed into BODY.HQR. The native renderer only
    ever resolves GenBody through the installed archive, and this editor
    has no business rewriting the user's game files just to give a new
    actor a nicer-looking placeholder.
  -->
  <ItemGroup>
    <!-- the full playable LBA2 engine (statically linked), for "LBA2: play scene"; extracted to native\ on first use -->
    <EmbeddedResource Include="native\lba2-classic-community\out\build\windows_ucrt64_static\SOURCES\lba2cc.exe"
          Condition="Exists('native\lba2-classic-community\out\build\windows_ucrt64_static\SOURCES\lba2cc.exe')"
          LogicalName="lba2cc.exe" />
    <EmbeddedResource Include="Assets\DummyBody.lm2" LogicalName="DummyBody.lm2" />
  </ItemGroup>

  <!--
    The human-readable scene/body/animation name lists (LBAPackageManager's
    .HQD text files) ship inside the exe, so scene and body names show up on
    a machine without LBAPackageManager installed. HqdDescriptions prefers a
    LBAPackageManager copy when one exists.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\FileDesc\*.HQD" LogicalName="FileDesc.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
