<Window x:Class="LBAAssembler.Lba1ActorAttributesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LBA1 Actor Attributes" Height="620" Width="780" MinHeight="480" MinWidth="660"
        Background="{DynamicResource ThemeFieldBrush}" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeWindowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7"/>
        </Style>
        <!-- TargetType="ComboBox" (not Control) so it actually inherits Theme.xaml's implicit ComboBox
             Template: see MainWindow.xaml's own DropdownBox comment for why a Control-typed style with no
             Template left these rendering with WPF's unthemed default ComboBox chrome. -->
        <Style x:Key="DropdownBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeWindowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock x:Name="EyebrowLabel" Text="LBA1 actor attributes" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="TitleLabel" Text="Actor 0" FontSize="19" Margin="0,4,0,4"/>
            <TextBlock x:Name="StatusLabel" Text="" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="11" Margin="0,0,0,4"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Position (X, Y, Z) / Facing" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PositionXBox" Grid.Column="0" Style="{StaticResource FieldBox}"/>
                    <TextBox x:Name="PositionYBox" Grid.Column="2" Style="{StaticResource FieldBox}"/>
                    <TextBox x:Name="PositionZBox" Grid.Column="4" Style="{StaticResource FieldBox}"/>
                    <TextBox x:Name="BetaBox" Grid.Column="6" Style="{StaticResource FieldBox}"/>
                </Grid>

                <TextBlock x:Name="EntityLabel" Text="Entity (FILE3D.HQR)" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="EntityCombo" Style="{StaticResource DropdownBox}" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"/>

                <TextBlock x:Name="BodyLabel" Text="Body" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="BodyCombo" Style="{StaticResource DropdownBox}" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"/>

                <TextBlock x:Name="AnimLabel" Text="Animation" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="AnimCombo" Style="{StaticResource DropdownBox}" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"/>

                <!-- Same 7-column split as the Position/Facing row above (three
                     equal fields plus 6px gaps) so the left box here lines up
                     exactly under fields 1-2 and the right box under fields
                     3-4, rather than an independent even 50/50 split. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="Life points" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="4" Grid.ColumnSpan="3" Text="Armour" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="LifePointBox" Style="{StaticResource FieldBox}"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3" x:Name="ArmourBox" Style="{StaticResource FieldBox}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Hit force" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3" Text="Move type" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="HitForceBox" Style="{StaticResource FieldBox}"/>
                    <TextBox Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="3" x:Name="MoveBox" Style="{StaticResource FieldBox}"/>
                </Grid>

                <TextBlock Text="Flags" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0" Grid.ColumnSpan="3" x:Name="FlagsListLeft">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          ToolTip="{Binding Description}" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,3,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Column="4" Grid.ColumnSpan="3" x:Name="FlagsListRight">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          ToolTip="{Binding Description}" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,3,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <TextBlock x:Name="WaypointsLabel" Text="" Foreground="{DynamicResource ThemeDisabledBrush}" FontFamily="Consolas" FontSize="10" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="PreviewBorder" Grid.Row="0" Background="{DynamicResource ThemeFieldBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                <Grid>
                    <Image x:Name="BodyPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Cursor="SizeWE"
                           MouseLeftButtonDown="BodyPreviewImage_MouseLeftButtonDown" MouseMove="BodyPreviewImage_MouseMove"
                           MouseLeftButtonUp="BodyPreviewImage_MouseLeftButtonUp"/>
                    <TextBlock x:Name="BodyPreviewFallbackLabel" Text="preview unavailable" Foreground="{DynamicResource ThemeBorderStrongBrush}" FontFamily="Consolas" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <CheckBox x:Name="PauseAnimationCheck" Content="Pause animation" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="Consolas" FontSize="10"
                          Checked="PauseAnimationCheck_Changed" Unchecked="PauseAnimationCheck_Changed"/>
                <TextBlock Text="Rotation speed" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
                <Slider x:Name="RotationSpeedSlider" Minimum="0" Maximum="96" Value="24" TickFrequency="8" IsSnapToTickEnabled="True"
                        ValueChanged="RotationSpeedSlider_ValueChanged"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Content="Apply" Click="Apply_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Edit Script&#8230;" Click="EditScript_Click" Style="{StaticResource QuietButton}"/>
            <Button Content="Close" Click="Close_Click" Style="{StaticResource QuietButton}"/>
        </StackPanel>
    </Grid>
</Window>
