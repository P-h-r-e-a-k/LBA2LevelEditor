<Window x:Class="LBAAssembler.ActorAttributesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actor Attributes" Height="620" Width="780" MinHeight="480" MinWidth="660"
        Background="#FFFFFF" Foreground="#10243E" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4E6B8A"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4E6B8A"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Foreground" Value="#10243E"/>
            <Setter Property="Background" Value="#E8F0FA"/>
            <Setter Property="BorderBrush" Value="#A9C3E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7"/>
        </Style>
        <Style x:Key="DropdownBox" TargetType="Control" BasedOn="{StaticResource FieldBox}">
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#10243E"/>
            <Setter Property="Background" Value="#D6E6F7"/>
            <Setter Property="BorderBrush" Value="#A9C3E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1B6EC2"/>
            <Setter Property="BorderBrush" Value="#1B6EC2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock x:Name="EyebrowLabel" Text="Actor attributes" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="TitleLabel" Text="Actor 0" FontSize="19" Margin="0,4,0,4"/>
            <TextBlock x:Name="StatusLabel" Text="" Foreground="#1B6EC2" FontSize="11" Margin="0,0,0,4"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <StackPanel x:Name="EntityPanel" Visibility="Collapsed">
                    <TextBlock Text="Kind of actor (needed to save a new actor to the game files)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="EntityCombo" Style="{StaticResource DropdownBox}" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"/>
                </StackPanel>

                <TextBlock Text="Body" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="BodyCombo" Style="{StaticResource DropdownBox}" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"/>

                <TextBlock Text="Animation" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="AnimCombo" Style="{StaticResource DropdownBox}" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"/>

                <TextBlock Text="Position (X, Y, Z) / Facing" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PositionXBox" Grid.Column="0" Style="{StaticResource FieldBox}"/>
                    <TextBox x:Name="PositionYBox" Grid.Column="2" Style="{StaticResource FieldBox}"/>
                    <TextBox x:Name="PositionZBox" Grid.Column="4" Style="{StaticResource FieldBox}"/>
                    <TextBox x:Name="BetaBox" Grid.Column="6" Style="{StaticResource FieldBox}"/>
                </Grid>

                <!-- Same 7-column split as the Position/Facing row above (four equal
                     fields plus 6px gaps), one combined label instead of the four
                     separate ones this used to have across two rows. -->
                <TextBlock Text="Life points / Armour / Hit force / Move type" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="LifePointBox" Style="{StaticResource FieldBox}"/>
                    <TextBox Grid.Column="2" x:Name="ArmourBox" Style="{StaticResource FieldBox}"/>
                    <TextBox Grid.Column="4" x:Name="HitForceBox" Style="{StaticResource FieldBox}"/>
                    <TextBox Grid.Column="6" x:Name="MoveBox" Style="{StaticResource FieldBox}"/>
                </Grid>

                <TextBlock Text="Flags" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0" Grid.ColumnSpan="3" x:Name="FlagsListLeft">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          ToolTip="{Binding Description}" Foreground="#10243E" Margin="0,3,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Column="4" Grid.ColumnSpan="3" x:Name="FlagsListRight">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          ToolTip="{Binding Description}" Foreground="#10243E" Margin="0,3,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <TextBlock x:Name="WaypointsLabel" Text="" Foreground="#7C93AC" FontFamily="Consolas" FontSize="10" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="PreviewBorder" Grid.Row="0" Background="#FFFFFF" BorderBrush="#A9C3E0" BorderThickness="1">
                <Grid>
                    <Image x:Name="BodyPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Cursor="SizeWE"
                           MouseLeftButtonDown="BodyPreviewImage_MouseLeftButtonDown" MouseMove="BodyPreviewImage_MouseMove"
                           MouseLeftButtonUp="BodyPreviewImage_MouseLeftButtonUp"/>
                    <TextBlock x:Name="BodyPreviewFallbackLabel" Text="preview unavailable" Foreground="#8FB0D6" FontFamily="Consolas" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <CheckBox x:Name="PauseAnimationCheck" Content="Pause animation" Foreground="#10243E" FontFamily="Consolas" FontSize="10"
                          Checked="PauseAnimationCheck_Changed" Unchecked="PauseAnimationCheck_Changed"/>
                <TextBlock Text="Rotation speed" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
                <Slider x:Name="RotationSpeedSlider" Minimum="0" Maximum="96" Value="24" TickFrequency="8" IsSnapToTickEnabled="True"
                        ValueChanged="RotationSpeedSlider_ValueChanged"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Content="Apply" Click="Apply_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Edit Script&#8230;" Click="EditScript_Click" Style="{StaticResource QuietButton}"/>
            <Button Content="Close" Click="Close_Click" Style="{StaticResource QuietButton}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Load Debug Body&#8230;" Click="LoadDebugBody_Click" Style="{StaticResource QuietButton}" Padding="9,5"
                    ToolTip="Load a body from a project test archive (e.g. mario.hqr) into a throwaway preview copy of BODY.HQR. Never modifies your real game files."/>
            <Button Content="Load Debug Anim&#8230;" Click="LoadDebugAnim_Click" Style="{StaticResource QuietButton}" Padding="9,5"
                    ToolTip="Load an animation from a project test archive into a throwaway preview copy of ANIM.HQR. Requires a debug body already loaded. Never modifies your real game files."/>
            <Button Content="Create New Body&#8230;" Click="CreateNewBody_Click" Style="{StaticResource QuietButton}" Margin="0" Padding="9,5"/>
        </StackPanel>
    </Grid>
</Window>
