<Window x:Class="LBA2LevelEditor.ActorAttributesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actor Attributes" Height="620" Width="720" MinHeight="480" MinWidth="600"
        Background="#101418" Foreground="#E8E6DA" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89958B"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA69C"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Foreground" Value="#DCE0C8"/>
            <Setter Property="Background" Value="#151B18"/>
            <Setter Property="BorderBrush" Value="#3A4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C5C6B9"/>
            <Setter Property="Background" Value="#182019"/>
            <Setter Property="BorderBrush" Value="#3B4740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="#131713"/>
            <Setter Property="Background" Value="#D6C86A"/>
            <Setter Property="BorderBrush" Value="#D6C86A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock x:Name="EyebrowLabel" Text="ACTOR ATTRIBUTES" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="TitleLabel" Text="Actor 0" FontSize="19" Margin="0,4,0,4"/>
            <TextBlock x:Name="StatusLabel" Text="" Foreground="#D6C86A" FontSize="11" Margin="0,0,0,4"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Position (X, Y, Z)" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PositionXBox" Grid.Column="0" Style="{StaticResource FieldBox}"/>
                    <TextBox x:Name="PositionYBox" Grid.Column="2" Style="{StaticResource FieldBox}"/>
                    <TextBox x:Name="PositionZBox" Grid.Column="4" Style="{StaticResource FieldBox}"/>
                </Grid>

                <TextBlock Text="Facing (beta)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="BetaBox" Style="{StaticResource FieldBox}"/>

                <TextBlock Text="Body" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="BodyCombo" Style="{StaticResource FieldBox}" IsEditable="True" StaysOpenOnEdit="True"
                          SelectionChanged="BodyCombo_SelectionChanged"
                          LostFocus="BodyCombo_LostFocus" GotFocus="BodyCombo_GotFocus"/>

                <TextBlock Text="Animation" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="AnimCombo" Style="{StaticResource FieldBox}" IsEditable="True" StaysOpenOnEdit="True"
                          SelectionChanged="AnimCombo_SelectionChanged"
                          LostFocus="AnimCombo_LostFocus" GotFocus="AnimCombo_GotFocus"/>

                <TextBlock Text="Life points" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LifePointBox" Style="{StaticResource FieldBox}"/>

                <TextBlock Text="Armor" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ArmorBox" Style="{StaticResource FieldBox}"/>

                <TextBlock Text="Hit force" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="HitForceBox" Style="{StaticResource FieldBox}"/>

                <TextBlock Text="Move type" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="MoveBox" Style="{StaticResource FieldBox}"/>

                <TextBlock Text="Flags" Style="{StaticResource FieldLabel}"/>
                <ItemsControl x:Name="FlagsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      ToolTip="{Binding Description}" Foreground="#DCE0C8" Margin="0,3,0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="WaypointsLabel" Text="" Foreground="#78847B" FontFamily="Consolas" FontSize="10" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="PreviewBorder" Grid.Row="1" Grid.Column="2" Background="#0D1210" BorderBrush="#3A4740" BorderThickness="1">
            <Grid>
                <Image x:Name="BodyPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock x:Name="BodyPreviewFallbackLabel" Text="preview unavailable" Foreground="#5C6B60" FontFamily="Consolas" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Apply" Click="Apply_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Edit Script&#8230;" Click="EditScript_Click" Style="{StaticResource QuietButton}"/>
            <Button Content="Close" Click="Close_Click" Style="{StaticResource QuietButton}"/>
        </StackPanel>
    </Grid>
</Window>
